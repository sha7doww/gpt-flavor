# ===== Required =====
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://your-openai-compatible-proxy/v1   # optional, leave unset for OpenAI default

# ===== Optional: 仅重新采集数据时需要 =====
# 本项目 data/ 已预装 8,694 条样本，重跑 bash run_all.sh 不会触发 collect.py。
# 下面三项只在你想跑 `python -m src.collect` 重采、且不用 CLI --models/--budget 覆盖时才生效。
# PRIMARY_MODEL=gpt-5.4
# COMPARE_MODEL=gpt-4o-2024-11-20
# BUDGET_USD=20.0
